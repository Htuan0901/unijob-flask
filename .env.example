# Sao chép thành .env rồi điền giá trị. KHÔNG commit tệp .env lên Git.
SECRET_KEY=doi-thanh-chuoi-ngau-nhien-dai
# Production (Render/Neon): FLASK_CONFIG=production, DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# CV_STORAGE=db          (lưu CV PDF trong CSDL thay vì instance/uploads/cv)
# DEV_DATABASE_URL=mysql+pymysql://unijob:unijob@localhost/unijob?charset=utf8mb4

# ---- Gửi email thật qua API Brevo (dùng trên Render vì gói free chặn SMTP) ----
