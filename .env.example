# MAIL_PORT=587
# MAIL_USE_TLS=1
# MAIL_USERNAME=ban@gmail.com
# MAIL_PASSWORD=xxxxxxxxxxxxxxxx
# MAIL_DEFAULT_SENDER=UniJob <ban@gmail.com>

